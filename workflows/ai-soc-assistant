    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Wazuh is an input format, not our internal language (Build Guide S8).\n// Build one stable internal object. Missing values become explicit null,\n// never a fabricated default, and we keep the original alert for provenance.\nconst body = $json.raw_body;\n\nfunction get(path, fallback = null) {\n  try {\n    const val = path.split('.').reduce((o, k) => (o == null ? undefined : o[k]), body);\n    return (val === undefined || val === '') ? fallback : val;\n  } catch (e) {\n    return fallback;\n  }\n}\n\nconst normalized = {\n  wazuh_alert_id: get('id'),\n  timestamp: get('timestamp'),\n  rule: {\n    id: get('rule.id'),\n    description: get('rule.description'),\n    level: get('rule.level'),\n    groups: get('rule.groups', [])\n  },\n  host: { name: get('agent.name'), ip: get('agent.ip') },\n  user: get('data.win.eventdata.targetUserName') || get('data.srcuser') || get('data.dstuser'),\n  process: get('data.win.eventdata.image') || get('data.process.name'),\n  parent_process: get('data.win.eventdata.parentImage'),\n  command_line: get('data.win.eventdata.commandLine'),\n  auth_result: get('data.win.eventdata.status'),\n  network: { source_ip: get('data.srcip'), destination_ip: get('data.dstip') },\n  file: { path: get('syscheck.path'), event: get('syscheck.event') },\n  full_log: get('full_log'),\n  raw_alert: body\n};\n\nreturn { json: normalized };"
      },
