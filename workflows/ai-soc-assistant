      "id": "89037862-90f5-4488-9816-438ea092f82a",
      "name": "Build LLM Prompt"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Build Guide S18: priority is deterministic, not left to the model alone.\nconst level = $json.rule?.level ?? 0;\nconst hasVerifiedMitre = ($json.evidence_package?.enrichment?.mitre_verified || []).length > 0;\nconst cve = $json.evidence_package?.enrichment?.cve_context || {};\nconst cvssScore = cve.cvss_score || 0;\nconst verdict = $json.ai?.verdict;\n\nlet score = 0;\nif (level >= 12) score += 4;\nelse if (level >= 9) score += 3;\nelse if (level >= 6) score += 2;\nelse score += 1;\n\nif (hasVerifiedMitre) score += 1;\nif (cvssScore >= 9) score += 3;\nelse if (cvssScore >= 7) score += 2;\nelse if (cvssScore > 0) score += 1;\nif (verdict === 'TRUE_POSITIVE') score += 2;\nelse if (verdict === 'NEEDS_INVESTIGATION') score += 1;\n\nlet priority;\nif (score >= 8) priority = 'P1';\nelse if (score >= 6) priority = 'P2';\nelse if (score >= 4) priority = 'P3';\nelse priority = 'P4';\n\nreturn { json: { ...$json, priority: { level: priority, score } } };"
      },
      "type": "n8n-nodes-base.code",
