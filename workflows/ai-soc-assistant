    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.raw_alert || {};\nconst mitreIdsRaw = raw?.rule?.mitre?.id ?? [];\nconst mitreTacticsRaw = raw?.rule?.mitre?.tactic ?? [];\nconst text = JSON.stringify(raw);\nconst cveIds = [...new Set(text.match(/CVE-\\d{4}-\\d{4,7}/g) || [])];\n\nreturn {\n  json: {\n    ...$json,\n    mitre_ids_observed: mitreIdsRaw,\n    mitre_tactics_observed: mitreTacticsRaw,\n    cve_ids_observed: cveIds\n  }\n};"
