    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Turn the raw NVD response into a small, verified context block.\n// Never throw here - an enrichment failure must not kill the whole alert.\nlet nvd_context = { status: 'NO_DATA' };\ntry {\n  const vuln = $json?.vulnerabilities?.[0]?.cve;\n  if (vuln) {\n    const desc = (vuln.descriptions || []).find(d => d.lang === 'en')?.value || null;\n    const metrics = vuln.metrics || {};\n    const cvssBlock = metrics.cvssMetricV31?.[0] || metrics.cvssMetricV30?.[0] || metrics.cvssMetricV2?.[0];\n    nvd_context = {\n      status: 'VERIFIED',\n      cve_id: vuln.id,\n      description: desc,\n      cvss_score: cvssBlock?.cvssData?.baseScore ?? null,\n      cvss_severity: cvssBlock?.cvssData?.baseSeverity ?? cvssBlock?.baseSeverity ?? null\n    };\n  } else {\n    nvd_context = { status: 'NOT_FOUND' };\n  }\n} catch (e) {\n  nvd_context = { status: 'ENRICHMENT_FAILED', error: String(e) };\n}\n\nreturn { json: { ...$('Resolve MITRE').item.json, nvd_context } };"
