    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Build Guide S9: the model must not invent MITRE context, and every\n// technique ID must be resolved against VERIFIED data before it reaches\n// the LLM. This is a small local lookup of the common techniques this\n// Wazuh ruleset actually surfaces - not the full ATT&CK dataset.\n// Anything not in this table is kept as UNRESOLVED, never dropped, so\n// the analyst knows to verify it manually at attack.mitre.org.\nconst MITRE_LOOKUP = {\n  'T1110': { name: 'Brute Force', tactic: 'Credential Access' },\n  'T1110.001': { name: 'Password Guessing', tactic: 'Credential Access' },\n  'T1110.003': { name: 'Password Spraying', tactic: 'Credential Access' },\n  'T1059': { name: 'Command and Scripting Interpreter', tactic: 'Execution' },\n  'T1059.001': { name: 'PowerShell', tactic: 'Execution' },\n  'T1078': { name: 'Valid Accounts', tactic: 'Defense Evasion / Persistence / Privilege Escalation / Initial Access' },\n  'T1021': { name: 'Remote Services', tactic: 'Lateral Movement' },\n  'T1053': { name: 'Scheduled Task/Job', tactic: 'Execution / Persistence / Privilege Escalation' },\n  'T1547': { name: 'Boot or Logon Autostart Execution', tactic: 'Persistence / Privilege Escalation' },\n  'T1490': { name: 'Inhibit System Recovery', tactic: 'Impact' },\n  'T1486': { name: 'Data Encrypted for Impact', tactic: 'Impact' },\n  'T1027': { name: 'Obfuscated Files or Information', tactic: 'Defense Evasion' },\n  'T1105': { name: 'Ingress Tool Transfer', tactic: 'Command and Control' },\n  'T1071': { name: 'Application Layer Protocol', tactic: 'Command and Control' },\n  'T1046': { name: 'Network Service Discovery', tactic: 'Discovery' },\n  'T1003': { name: 'OS Credential Dumping', tactic: 'Credential Access' },\n  'T1055': { name: 'Process Injection', tactic: 'Defense Evasion / Privilege Escalation' },\n  'T1566': { name: 'Phishing', tactic: 'Initial Access' },\n  'T1204': { name: 'User Execution', tactic: 'Execution' },\n  'T1565': { name: 'Data Manipulation', tactic: 'Impact' },\n  'T1565.001': { name: 'Stored Data Manipulation', tactic: 'Impact' },\n  'T1565.002': { name: 'Transmitted Data Manipulation', tactic: 'Impact' },\n  'T1565.003': { name: 'Runtime Data Manipulation', tactic: 'Impact' },\n  'T1070': { name: 'Indicator Removal', tactic: 'Defense Evasion' },\n  'T1036': { name: 'Masquerading', tactic: 'Defense Evasion' }\n};\n\nconst observedIds = $json.mitre_ids_observed || [];\nconst resolved = [];\nconst unresolved = [];\n\nfor (const id of observedIds) {\n  if (MITRE_LOOKUP[id]) {\n    resolved.push({ id, name: MITRE_LOOKUP[id].name, tactic: MITRE_LOOKUP[id].tactic, status: 'VERIFIED' });\n  } else {\n    unresolved.push({ id, status: 'UNRESOLVED_CHECK_MANUALLY' });\n  }\n}\n\nreturn { json: { ...$json, mitre_resolved: resolved, mitre_unresolved: unresolved } };"
