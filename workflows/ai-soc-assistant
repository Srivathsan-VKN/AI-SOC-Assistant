    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json;\n\nconst knownUnknowns = [];\nif (!j.user) knownUnknowns.push('user/account not present in alert');\nif (!j.process) knownUnknowns.push('process not present in alert');\nif (!j.parent_process) knownUnknowns.push('parent process not present in alert');\nif (!j.command_line) knownUnknowns.push('command line not present in alert');\nif (!j.network?.source_ip && !j.network?.destination_ip) knownUnknowns.push('network source/destination not present in alert');\nif ((j.mitre_unresolved || []).length > 0) knownUnknowns.push('one or more MITRE IDs could not be verified locally');\nif (j.nvd_context?.status === 'ENRICHMENT_FAILED') knownUnknowns.push('CVE enrichment failed - treat any CVE claim as unverified');\n\nconst evidence_package = {\n  alert: {\n    wazuh_alert_id: j.wazuh_alert_id,\n    timestamp: j.timestamp,\n    rule: j.rule,\n    host: j.host,\n    user: j.user,\n    process: j.process,\n    parent_process: j.parent_process,\n    command_line: j.command_line,\n    auth_result: j.auth_result,\n    network: j.network,\n    file: j.file,\n    full_log: j.full_log\n  },\n  enrichment: {\n    mitre_verified: j.mitre_resolved,\n    mitre_unresolved: j.mitre_unresolved,\n    cve_context: j.nvd_context\n  },\n  known_unknowns: knownUnknowns\n};\n\nreturn { json: { ...j, evidence_package } };"
      },
      "type": "n8n-nodes-base.code",
