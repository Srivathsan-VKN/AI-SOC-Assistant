        "jsCode": "// Terminal node for the invalid branch.\n// We never silently discard an alert - we always produce a record,\n// even when the alert couldn't be processed further.\nreturn {\n  json: {\n    status: 'REJECTED_INVALID_INPUT',\n    wazuh_alert_id: $json.raw_body?.id || null,\n    validation_errors: $json.validation_errors,\n    received_at: new Date().toISOString(),\n    message: 'Alert was missing required fields and could not be triaged. See validation_errors.'\n  }\n};"
