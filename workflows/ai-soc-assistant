        "jsCode": "// V1 requirement: an individual bad alert must not destroy the workflow.\n// This is the first gate: confirm the minimum fields we need even exist\n// before we try to normalize/enrich/reason about the alert.\nconst body = $json.body;\nconst errors = [];\n\nif (!body) errors.push('missing_body');\nif (body && !body.rule) errors.push('missing_rule');\nif (body && !body.timestamp) errors.push('missing_timestamp');\nif (body && !body.agent) errors.push('missing_agent');\n\nreturn {\n  json: {\n    raw_body: body || {},\n    validation_errors: errors,\n    is_valid: errors.length === 0\n  }\n};"
